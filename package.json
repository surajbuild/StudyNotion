  "scripts": {
    "start": "node --openssl-legacy-provider node_modules/react-scripts/bin/react-scripts.js start",
    "build": "node --openssl-legacy-provider node_modules/react-scripts/bin/react-scripts.js build",
    "test": "node --openssl-legacy-provider node_modules/react-scripts/bin/react-scripts.js test --watchAll=false",
    "test:server": "cd server && npm test",
    "test:server:integration": "cd server && npm run test:integration",
    "test:all": "npm test && npm run test:server",
    "test:e2e:isolated": "node e2e/authenticated.e2e.js",
    "start:test-backend": "node server/test-env/startIsolatedEnv.js",
    "eject": "react-scripts eject",
    "server": "node --watch server/index.js",
    "dev": "node dev.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
