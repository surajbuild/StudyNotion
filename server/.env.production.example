# ==============================================================================
# STUDYNOTION — PRODUCTION ENVIRONMENT CONFIGURATION MANIFEST
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=4000
RELEASE_VERSION=studynotion@1.0.0

# Frontend & CORS Configuration (SEC-001)
# Comma-separated list of exact allowed origins (no trailing slashes, NO wildcards)
ALLOWED_ORIGINS=https://studynotion.com,https://www.studynotion.com,https://studynotion-staging.vercel.app
FRONTEND_URL=https://studynotion.com

# Database Configuration (Phase 3)
# MongoDB Atlas Connection String with TLS/SSL
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studynotion?retryWrites=true&w=majority
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=2
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_SOCKET_TIMEOUT_MS=45000

# Authentication & Session Security (SEC-002, SEC-003, SEC-006)
# High-entropy random 256-bit secret string (e.g., generated with `openssl rand -hex 32`)
JWT_SECRET=your_production_high_entropy_jwt_secret_here

# Distributed Rate Limiting (SEC-007)
# Redis connection string for shared multi-instance rate limiting
REDIS_URL=rediss://default:<password>@<redis-host>:<port>

# Payment Gateway — Razorpay
# Live/Production credentials (or Test Mode keys during staging verification)
RAZORPAY_KEY=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret_here
# Dual-secret webhook rotation support (GAP-010)
RAZORPAY_WEBHOOK_SECRET=your_32char_webhook_secret_here
RAZORPAY_WEBHOOK_OLD_SECRET=

# Cloud Storage — Cloudinary (SEC-008)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
FOLDER_NAME=studynotion_production_uploads

# Transactional Email Infrastructure (Phase 5)
# Options: smtp (default), resend, sendgrid
MAIL_PROVIDER=resend
# For Resend:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# For SendGrid:
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# For Standard SMTP / AWS SES:
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=resend
MAIL_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="StudyNotion Support <support@studynotion.com>"

# Observability & APM (Phase 6 & 7)
LOG_LEVEL=info
SENTRY_DSN=https://<public_key>@o<org_id>.ingest.sentry.io/<project_id>
SENTRY_TRACES_SAMPLE_RATE=0.1
