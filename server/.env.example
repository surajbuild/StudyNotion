# StudyNotion Server Environment Variables Example
PORT=4000
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/studynotion
FRONTEND_URL=https://studynotion.example.com
ALLOWED_ORIGINS=https://studynotion.example.com,https://staging.studynotion.example.com

# Authentication & Security
JWT_SECRET=replace_with_high_entropy_random_jwt_secret

# Razorpay Payment Gateway & Webhook
RAZORPAY_KEY=rzp_live_replace_with_actual_key
RAZORPAY_SECRET=replace_with_razorpay_api_secret
# Dedicated Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
# Optional: Prior webhook secret during key rotation window
# RAZORPAY_WEBHOOK_OLD_SECRET=replace_with_previous_webhook_secret

# Cloudinary Storage
CLOUD_NAME=replace_with_cloudinary_cloud_name
API_KEY=replace_with_cloudinary_api_key
API_SECRET=replace_with_cloudinary_api_secret
FOLDER_NAME=StudyNotion

# Transactional Email (SMTP / Service)
MAIL_HOST=smtp.gmail.com
MAIL_USER=replace_with_smtp_email
MAIL_PASS=replace_with_smtp_password
