# Isolated Test Environment Template (DO NOT put production credentials here)
NODE_ENV=test
STUDYNOTION_TEST_MODE=true
TEST_MOCK_EXTERNAL_SERVICES=true

# Dedicated isolated test MongoDB URI (must point to localhost/127.0.0.1/mongo-test and contain "test" in DB name)
MONGODB_TEST_URL=mongodb://127.0.0.1:27018/studynotion_test

# Isolated test server settings (does not collide with dev port 4000)
PORT=4001
FRONTEND_URL=http://localhost:3001

# Synthetic test-only signing secrets (never reuse production keys)
JWT_SECRET=studynotion-isolated-test-jwt-secret
RAZORPAY_KEY=rzp_test_isolated_mock_key
RAZORPAY_SECRET=studynotion-isolated-test-razorpay-secret
FOLDER_NAME=studynotion_test_uploads
